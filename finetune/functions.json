[
  {
    "type": "function",
    "function": {
      "name": "set_alarm",
      "description": "Set an alarm on the phone's clock.",
      "parameters": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "description": "The time exactly as spoken, e.g. '6 am', '5:45 pm', 'seven thirty', '8:30 tonight'."
          },
          "day": {
            "type": "string",
            "enum": [
              "today",
              "tomorrow",
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ],
            "description": "Only if the user names a day."
          },
          "label": {
            "type": "string",
            "description": "What the alarm is for, if said."
          }
        },
        "required": [
          "time"
        ]
      }
    }
  },
  {
